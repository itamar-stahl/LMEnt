# Run folders are per-submission working state: config copies, artifacts,
# generated job scripts, logs and checkpoints. They are records of a run, not
# source -- the run folder is what you inspect on the cluster, never what you
# commit. (framework/client/prepare.py builds them; see README.)
runs/

# Python bytecode
__pycache__/
*.py[cod]

# Scratch the trainer leaves in its working directory: torch.compile's inductor
# cache and OpenMP's per-process temporaries. Created on the node, never source.
tmp*/
pymp-*/
torchinductor_*/

# SLURM captured next to a test instead of in a run folder.
tests/*.out
tests/*.err
