{
  // Where this run reads and writes. Paths only.
  "job": {
    "dataset_paths": "${LMENT_DATASET}/dataset-tokenized/*.npy",
    "dataset_cache": "${LMENT_DATASET}/dataset-cache",
    "save_folder": "${UNTAUGHT_RUNS_DIR}/control_170m"
  },

  // Everything the model and the optimizer see.
  "train": {
    "model": "olmo2_170M",
    "init_seed": 12536,
    "max_duration_value": 200,
    "max_duration_unit": "steps",

    // optimizer: AdamW, cosine schedule with warmup
    "optim_lr": 0.0005,
    "optim_weight_decay": 0.05,
    "optim_warmup_steps": 1000,
    "optim_max_grad_norm": 1.0,

    // batching, in tokens
    "data_global_batch_size": 32768,
    "data_rank_microbatch_size": 8192,
    "data_seed": 0,
    "data_num_workers": 4,
    "data_prefetch_factor": 8,

    // dataset construction
    "dataset_name": "kas_vsl",
    "dataset_max_sequence_length": 2048,
    "dataset_min_sequence_length": 64,
    "dataset_include_instance_metadata": false,
    "vsl_curriculum": "grow_p2",
    "vsl_num_cycles": 8,
    "vsl_balanced": false,

    // checkpoints and logging
    "checkpoint_save_interval": 100,
    "checkpoint_ephemeral_save_interval": 50,
    "checkpoint_save_async": true,
    "checkpoint_save_overwrite": true,
    "metrics_collect_interval": 1,
    "cancel_check_interval": 5,
    "wandb_cancel_check_interval": 10,
    "eval_tasks": ["arc_easy"],
    "eval_interval": 100000
  },

  // The ablation. null blacklist => nothing held out => this is the control.
  "untaught": {
    "blacklist": null,
    "enabled": true,
    "adapt_to_gpu": true,
    "disable_wandb": true,
    "disable_downstream_eval": true
  }
}

// SMOKE CONTROL RUN: 170M, nothing held out.
//
// The baseline half of the pair. It must stay identical to
// train_170m_no_harry_potter.json in every field except job.save_folder and the
// untaught block -- same init_seed, same data_seed, same duration. That is what
// makes the comparison a controlled one.
//
// Hyperparameters follow the paper (appendix B.4): AdamW, global batch 32,768
// tokens, rank batch 8,192, peak lr 5e-4, weight decay 0.05, 1,000 warmup steps.
// These differ from the checked-in OLMo-core kas_config.json, which has lr 3e-4 /
// wd 0.01 and does not match the released models.
//
// max_duration is 200 steps for a smoke test. A real 1-epoch run is ~109K steps
// (3.6B tokens / 32,768 tokens per step).
//
// dataset_include_instance_metadata is false on purpose: chunk exclusion keys off
// batch["index"], never off the per-chunk entity metadata, so training does not
// need to touch the 212GB dataset-metadata tree. This is also what OLMo-core's own
// write_dataloader_batch_indices.py recommends for training.
//
// data_rank_microbatch_size is a memory knob only -- gradient accumulation keeps
// data_global_batch_size fixed, so untaught.adapt_to_gpu may lower it to fit a
// small card without changing the optimizer math.
